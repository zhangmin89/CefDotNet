<Project>
    <!-- Keep repository builds self-contained instead of running Avalonia's user-profile telemetry task. -->
    <PropertyGroup>
        <UsedAvaloniaProducts />
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsPackable)' == 'false'">
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <DocumentationFile />
    </PropertyGroup>

    <!-- NuGet 自动导入 buildTransitive；仓库内的示例和测试通过同一份目标消费本地产物。 -->
    <PropertyGroup Condition="'$(CefGlueUseLocalRuntimeAssets)' == 'true'">
        <CefGluePrepareRuntimeAssetsTargets>PublishCefGlueBrowserProcessForLocalBuild</CefGluePrepareRuntimeAssetsTargets>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)src\CefGlue.Common\buildTransitive\CefGlue.Common.props" Condition="'$(CefGlueUseLocalRuntimeAssets)' == 'true'" />

    <PropertyGroup Condition="'$(CefGlueUseLocalRuntimeAssets)' == 'true'">
        <CefGlueBrowserProcessAssetsPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)artifacts\browser-process\local\$(MSBuildProjectName)\$(Configuration)\$(CefGlueTargetRuntimeIdentifier)\'))</CefGlueBrowserProcessAssetsPath>
        <CefGlueBrowserProcessBuildArtifactsPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)artifacts\browser-process\local-build\$(MSBuildProjectName)\$(Configuration)\$(CefGlueTargetRuntimeIdentifier)'))</CefGlueBrowserProcessBuildArtifactsPath>
        <CefGlueBrowserProcessExecutableName Condition="$([System.String]::Copy('$(CefGlueTargetRuntimeIdentifier)').StartsWith('win-'))">Xilium.CefGlue.BrowserProcess.exe</CefGlueBrowserProcessExecutableName>
        <CefGlueBrowserProcessExecutableName Condition="'$(CefGlueBrowserProcessExecutableName)' == ''">Xilium.CefGlue.BrowserProcess</CefGlueBrowserProcessExecutableName>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)src\CefGlue.Common\buildTransitive\CefGlue.Common.targets" Condition="'$(CefGlueUseLocalRuntimeAssets)' == 'true'" />

    <Target Name="PublishCefGlueBrowserProcessForLocalBuild" Condition="'$(CefGlueUseLocalRuntimeAssets)' == 'true'">
        <!-- Isolate every consumer's BrowserProcess build graph so nested publishes can run concurrently. -->
        <MSBuild Projects="$(MSBuildThisFileDirectory)src\CefGlue.BrowserProcess\CefGlue.BrowserProcess.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(CefGlueTargetRuntimeIdentifier);SelfContained=true;UseAppHost=true;ArtifactsPath=$(CefGlueBrowserProcessBuildArtifactsPath);PublishDir=$(CefGlueBrowserProcessAssetsPath)" />
        <Error Condition="!Exists('$(CefGlueBrowserProcessAssetsPath)$(CefGlueBrowserProcessExecutableName)')" Text="CefGlue browser process publish did not produce '$(CefGlueBrowserProcessAssetsPath)$(CefGlueBrowserProcessExecutableName)'." />
    </Target>
</Project>
