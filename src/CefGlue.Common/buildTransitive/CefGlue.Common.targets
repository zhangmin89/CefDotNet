<Project>
    <Target Name="ResolveCefGlueRuntimeIdentifier" BeforeTargets="ProcessFrameworkReferences">
        <PropertyGroup>
            <!-- 执行时再读取 RID，此时项目与 SDK 的属性已经完成求值。 -->
            <CefGlueTargetRuntimeIdentifier>$(RuntimeIdentifier)</CefGlueTargetRuntimeIdentifier>
            <CefGlueTargetRuntimeIdentifier Condition="'$(CefGlueTargetRuntimeIdentifier)' == ''">$(DefaultAppHostRuntimeIdentifier)</CefGlueTargetRuntimeIdentifier>
            <CefGlueTargetRuntimeIdentifier Condition="'$(CefGlueTargetRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</CefGlueTargetRuntimeIdentifier>
            <CefGlueTargetRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $(CefGlueTargetRuntimeIdentifier.StartsWith('win-')) and '$(PlatformTarget)' != '' and '$(PlatformTarget)' != 'AnyCPU'">win-$(PlatformTarget.ToLowerInvariant())</CefGlueTargetRuntimeIdentifier>
            <!-- 子进程需要 apphost；主程序关闭 UseAppHost 时也让 SDK 解析相应的 host pack。 -->
            <AppHostRuntimeIdentifier Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(IsTestProject)' == 'true') and '$(AppHostRuntimeIdentifier)' == ''">$(CefGlueTargetRuntimeIdentifier)</AppHostRuntimeIdentifier>
        </PropertyGroup>
    </Target>

    <Target Name="ValidateCefGlueRuntimeAssets" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolveCefGlueRuntimeIdentifier">
        <Error Condition="'$(CefGlueTargetRuntimeIdentifier)' != 'win-x64' and '$(CefGlueTargetRuntimeIdentifier)' != 'win-arm64' and '$(CefGlueTargetRuntimeIdentifier)' != 'linux-x64' and '$(CefGlueTargetRuntimeIdentifier)' != 'linux-arm64' and '$(CefGlueTargetRuntimeIdentifier)' != 'osx-x64' and '$(CefGlueTargetRuntimeIdentifier)' != 'osx-arm64'" Text="CefGlue supports win-x64, win-arm64, linux-x64, linux-arm64, osx-x64 and osx-arm64; resolved '$(CefGlueTargetRuntimeIdentifier)'. Set RuntimeIdentifier explicitly when cross-compiling." />
    </Target>

    <Target Name="CollectCefGlueRuntimeAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="ValidateCefGlueRuntimeAssets;$(CefGluePrepareRuntimeAssetsTargets);CreateCefGlueBrowserProcessAppHost;PrepareCefGlueBrowserProcessRuntimeFiles" Condition="'$(DesignTimeBuild)' != 'true'">
        <!-- 切换架构时，新选中的资源和缓存 apphost 可能更旧；必须按当前来源复制。 -->
        <ItemGroup Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'osx-x64' or '$(CefGlueTargetRuntimeIdentifier)' == 'osx-arm64'">
            <_CefGlueMacOSRuntimeAsset Include="@(CefRedistOSX64)" Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'osx-x64'" />
            <_CefGlueMacOSRuntimeAsset Include="@(CefRedistOSXARM64)" Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'osx-arm64'" />
            <None Include="@(_CefGlueMacOSRuntimeAsset)">
                <Visible>false</Visible>
                <Link>%(_CefGlueMacOSRuntimeAsset.RecursiveDir)%(_CefGlueMacOSRuntimeAsset.FileName)%(_CefGlueMacOSRuntimeAsset.Extension)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
        </ItemGroup>

        <ItemGroup Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'linux-x64' or '$(CefGlueTargetRuntimeIdentifier)' == 'linux-arm64'">
            <_CefGlueLinuxRuntimeAsset Include="@(CefRedistLinux64)" Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'linux-x64'" />
            <_CefGlueLinuxRuntimeAsset Include="@(CefRedistLinuxARM64)" Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'linux-arm64'" />
            <None Include="@(_CefGlueLinuxRuntimeAsset)">
                <Visible>false</Visible>
                <Link>%(_CefGlueLinuxRuntimeAsset.RecursiveDir)%(_CefGlueLinuxRuntimeAsset.FileName)%(_CefGlueLinuxRuntimeAsset.Extension)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
        </ItemGroup>

        <ItemGroup>
            <!-- 共享 DLL 使用主程序已经解析的引用，避免同目录下重复复制和覆盖。 -->
            <_CefGlueBrowserProcessAsset Include="$(CefGlueBrowserProcessAssetsPath)Xilium.CefGlue.BrowserProcess.*" />
            <_CefGlueBrowserProcessAsset Remove="$(CefGlueBrowserProcessAssetsPath)Xilium.CefGlue.BrowserProcess.runtimeconfig.json;$(CefGlueBrowserProcessAssetsPath)Xilium.CefGlue.BrowserProcess.deps.json" Condition="'$(SelfContained)' == 'true'" />
            <_CefGlueBrowserProcessAsset Include="@(_CefGlueBrowserProcessRuntimeFile)" />
            <_CefGlueBrowserProcessAsset Include="$(_CefGlueBrowserProcessAppHost)" Condition="'$(_CefGlueBrowserProcessAppHost)' != ''" />
            <None Include="@(_CefGlueBrowserProcessAsset)">
                <Visible>false</Visible>
                <Link>%(_CefGlueBrowserProcessAsset.FileName)%(_CefGlueBrowserProcessAsset.Extension)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
                <PublishState>Included</PublishState>
            </None>
            <FileWrites Include="$(_CefGlueBrowserProcessAppHost)" Condition="'$(_CefGlueBrowserProcessAppHost)' != ''" />
        </ItemGroup>
    </Target>

    <!-- 自包含消费共享主程序的 runtime pack，但保留子进程自己的托管依赖。 -->
    <Target Name="PrepareCefGlueBrowserProcessRuntimeFiles" DependsOnTargets="ResolveRuntimePackAssets" Condition="'$(SelfContained)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_CefGlueBrowserProcessRuntimeDirectory>$(IntermediateOutputPath)cefglue-browser-process\$(CefGlueTargetRuntimeIdentifier)\self-contained\</_CefGlueBrowserProcessRuntimeDirectory>
        </PropertyGroup>
        <ItemGroup>
            <_CefGlueBrowserProcessRuntimePackAsset Include="@(RuntimePackAsset)" Condition="'%(RuntimePackAsset.NuGetPackageId)' == 'Microsoft.NETCore.App.Runtime.$(RuntimeIdentifier)' and ('%(RuntimePackAsset.AssetType)' == 'runtime' or '%(RuntimePackAsset.AssetType)' == 'native')" />
            <_CefGlueBrowserProcessRuntimeFramework Include="@(RuntimeFramework)" Condition="'%(RuntimeFramework.Identity)' == 'Microsoft.NETCore.App'" />
            <_CefGlueBrowserProcessRuntimeFile Include="$(_CefGlueBrowserProcessRuntimeDirectory)Xilium.CefGlue.BrowserProcess.runtimeconfig.json;$(_CefGlueBrowserProcessRuntimeDirectory)Xilium.CefGlue.BrowserProcess.deps.json" />
        </ItemGroup>
        <MakeDir Directories="$(_CefGlueBrowserProcessRuntimeDirectory)" />
        <GenerateRuntimeConfigurationFiles AssetsFilePath="$(ProjectAssetsFile)" TargetFramework="$(TargetFramework)" TargetFrameworkMoniker="$(TargetFrameworkMoniker)" RuntimeConfigPath="$(_CefGlueBrowserProcessRuntimeDirectory)Xilium.CefGlue.BrowserProcess.runtimeconfig.json" RuntimeIdentifier="$(RuntimeIdentifier)" RuntimeFrameworks="@(_CefGlueBrowserProcessRuntimeFramework)" IsSelfContained="true" WriteIncludedFrameworks="true" />
        <GenerateCefGlueBrowserProcessDeps SourcePath="$(CefGlueBrowserProcessAssetsPath)Xilium.CefGlue.BrowserProcess.deps.json" DestinationPath="$(_CefGlueBrowserProcessRuntimeDirectory)Xilium.CefGlue.BrowserProcess.deps.json" TargetFrameworkMoniker="$(TargetFrameworkMoniker)" RuntimeIdentifier="$(RuntimeIdentifier)" RuntimePackAssets="@(_CefGlueBrowserProcessRuntimePackAsset)" />
        <ItemGroup>
            <FileWrites Include="@(_CefGlueBrowserProcessRuntimeFile)" />
        </ItemGroup>
    </Target>

    <UsingTask TaskName="GenerateCefGlueBrowserProcessDeps" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourcePath ParameterType="System.String" Required="true" />
            <DestinationPath ParameterType="System.String" Required="true" />
            <TargetFrameworkMoniker ParameterType="System.String" Required="true" />
            <RuntimeIdentifier ParameterType="System.String" Required="true" />
            <RuntimePackAssets ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
        </ParameterGroup>
        <Task>
            <!-- 内联任务直接读取引用路径，使用跨平台分隔符；复用 SDK 的 net472 引用，不向消费项目引入 JSON 依赖。 -->
            <Reference Include="$(MSBuildSDKsPath)/Microsoft.NET.Sdk/tools/net472/Newtonsoft.Json.dll" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="Newtonsoft.Json.Linq" />
            <Code Type="Fragment" Language="cs"><![CDATA[
            var document = JObject.Parse(File.ReadAllText(SourcePath));
            var target = (JObject)document["targets"].First.First.DeepClone();
            var targetName = TargetFrameworkMoniker + "/" + RuntimeIdentifier;
            document["runtimeTarget"]["name"] = targetName;
            document["targets"] = new JObject { [targetName] = target };
            var helper = (JObject)target.Properties().Single(property => property.Name.StartsWith("Xilium.CefGlue.BrowserProcess/")).Value;
            foreach (var pack in RuntimePackAssets.GroupBy(asset => asset.GetMetadata("NuGetPackageId")))
            {
                var version = pack.First().GetMetadata("NuGetPackageVersion");
                var name = "runtimepack." + pack.Key;
                var library = new JObject();
                foreach (var group in pack.GroupBy(asset => asset.GetMetadata("AssetType")))
                {
                    var files = new JObject();
                    foreach (var asset in group) { files[asset.GetMetadata("DestinationSubPath").Replace('\\', '/')] = new JObject(); }
                    library[group.Key] = files;
                }
                target[name + "/" + version] = library;
                document["libraries"][name + "/" + version] = new JObject { ["type"] = "runtimepack", ["serviceable"] = false, ["sha512"] = "" };
                helper["dependencies"][name] = version;
            }
            File.WriteAllText(DestinationPath, document.ToString());
            ]]></Code>
        </Task>
    </UsingTask>

    <!-- BrowserProcess 独立运行，主程序发布为单文件时也需要保留这两个共享 DLL。 -->
    <Target Name="KeepCefGlueBrowserProcessDependenciesExternal" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.FileName)' == 'Xilium.CefGlue' or '%(ResolvedFileToPublish.FileName)' == 'Xilium.CefGlue.Common.Shared'">
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <!-- 主程序按 SDK 规则打包运行时；打包后再为独立子进程保留外部副本。 -->
    <Target Name="IncludeCefGlueBrowserProcessRuntimeAfterBundle" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(_CefGlueBrowserProcessRuntimePackAsset)" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>%(_CefGlueBrowserProcessRuntimePackAsset.DestinationSubPath)</RelativePath>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <Target Name="ResolveCEFAssets" AfterTargets="ResolvePackageAssets">
        <ItemGroup Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'win-x64' or '$(CefGlueTargetRuntimeIdentifier)' == 'win-arm64'">
            <CefRuntimeFiles Include="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.$(CefGlueTargetRuntimeIdentifier)'))" />
            <None Include="@(CefRuntimeFiles)">
                <Visible>false</Visible>
                <Link>%(CefRuntimeFiles.FileName)%(CefRuntimeFiles.Extension)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
            <_CefGlueWindowsLocale Include="@(CefRuntimeWin64Locales)" Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'win-x64'" />
            <_CefGlueWindowsLocale Include="@(CefRuntimeWinArm64Locales)" Condition="'$(CefGlueTargetRuntimeIdentifier)' == 'win-arm64'" />
            <None Include="@(_CefGlueWindowsLocale)">
                <Visible>false</Visible>
                <Link>locales\%(_CefGlueWindowsLocale.RecursiveDir)%(_CefGlueWindowsLocale.FileName)%(_CefGlueWindowsLocale.Extension)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
            </None>
        </ItemGroup>
        <ItemGroup>
            <!-- 所有平台均按目标 RID 单独收集 CEF，移除 SDK 默认复制的两套 Windows runtimes 资源。 -->
            <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.win-x64'));@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.win-arm64'))" />
        </ItemGroup>
    </Target>

    <!-- 显式 RID 的 Windows native 文件由 SDK 收集，发布时也不能仅按源文件是否更新判断。 -->
    <Target Name="RefreshCefRuntimePublishAssets" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.win-x64'));@(ResolvedFileToPublish->WithMetadataValue('NuGetPackageId', 'chromiumembeddedframework.runtime.win-arm64'))" CopyToPublishDirectory="Always" />
        </ItemGroup>
    </Target>

    <UsingTask TaskName="CreateAppHost" AssemblyFile="$(MicrosoftNETBuildTasksAssembly)" />
    <UsingTask TaskName="PatchPeStackReserve" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />

            <StackReserveBytes ParameterType="System.Int64" Required="true" />
        </ParameterGroup>

        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />

            <Code Type="Fragment" Language="cs">
            <![CDATA[
            using var stream = new FileStream(
                FilePath,
                FileMode.Open,
                FileAccess.ReadWrite,
                FileShare.Read);

            using var reader = new BinaryReader(
                stream,
                System.Text.Encoding.UTF8,
                leaveOpen: true);

            using var writer = new BinaryWriter(
                stream,
                System.Text.Encoding.UTF8,
                leaveOpen: true);

            // DOS header -> e_lfanew
            stream.Position = 0x3C;
            var peOffset = reader.ReadInt32();

            // PE\0\0
            stream.Position = peOffset;
            if (reader.ReadUInt32() != 0x00004550)
            {
                throw new InvalidDataException(
                    $"'{FilePath}' is not a valid PE executable.");
            }

            // PE signature(4) + COFF header(20)
            var optionalHeaderOffset = peOffset + 24;

            stream.Position = optionalHeaderOffset;
            var magic = reader.ReadUInt16();

            // SizeOfStackReserve is offset 72 in both
            // IMAGE_OPTIONAL_HEADER32 and IMAGE_OPTIONAL_HEADER64.
            stream.Position = optionalHeaderOffset + 72;

            switch (magic)
            {
                // PE32
                case 0x10B:
                    writer.Write(checked((uint)StackReserveBytes));
                    break;

                // PE32+
                case 0x20B:
                    writer.Write(checked((ulong)StackReserveBytes));
                    break;

                default:
                    throw new InvalidDataException(
                        $"Unsupported PE optional header magic: 0x{magic:X}");
            }

            writer.Flush();
            ]]>
        </Code>
        </Task>
    </UsingTask>
    <Target Name="PrepareCefGlueBrowserProcessAppHost" DependsOnTargets="ValidateCefGlueRuntimeAssets;$(CefGluePrepareRuntimeAssetsTargets);ResolveFrameworkReferences" Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(IsTestProject)' == 'true') and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <!-- 都不要换行 -->
            <_CefGlueBrowserProcessExecutableName Condition="$(CefGlueTargetRuntimeIdentifier.StartsWith('win-'))">Xilium.CefGlue.BrowserProcess.exe</_CefGlueBrowserProcessExecutableName>
            <_CefGlueBrowserProcessExecutableName Condition="'$(_CefGlueBrowserProcessExecutableName)' == ''">Xilium.CefGlue.BrowserProcess</_CefGlueBrowserProcessExecutableName>
            <_CefGlueBrowserProcessIntermediateDirectory>$(IntermediateOutputPath)cefglue-browser-process\$(CefGlueTargetRuntimeIdentifier)\</_CefGlueBrowserProcessIntermediateDirectory>
            <_CefGlueBrowserProcessAppHost>$(_CefGlueBrowserProcessIntermediateDirectory)$(_CefGlueBrowserProcessExecutableName)</_CefGlueBrowserProcessAppHost>
            <_CefGlueBrowserProcessStagingAppHost>$(_CefGlueBrowserProcessIntermediateDirectory)staging\$(_CefGlueBrowserProcessExecutableName)</_CefGlueBrowserProcessStagingAppHost>
            <_CefGlueBrowserProcessAssembly>$(CefGlueBrowserProcessAssetsPath)Xilium.CefGlue.BrowserProcess.dll</_CefGlueBrowserProcessAssembly>
            <_CefGlueBrowserProcessWindowsGui>false</_CefGlueBrowserProcessWindowsGui>
            <_CefGlueBrowserProcessWindowsGui Condition="$(CefGlueTargetRuntimeIdentifier.StartsWith('win-'))">true</_CefGlueBrowserProcessWindowsGui>
            <_CefGlueBrowserProcessMacOSCodeSign>false</_CefGlueBrowserProcessMacOSCodeSign>
            <_CefGlueBrowserProcessMacOSCodeSign Condition="$(CefGlueTargetRuntimeIdentifier.StartsWith('osx-'))">true</_CefGlueBrowserProcessMacOSCodeSign>
        </PropertyGroup>
        <Error Condition="'$(AppHostSourcePath)' == '' or !Exists('$(AppHostSourcePath)')" Text="Unable to resolve apphost for RuntimeIdentifier '$(CefGlueTargetRuntimeIdentifier)'." />
        <Error Condition="!Exists('$(_CefGlueBrowserProcessAssembly)')" Text="CefGlue BrowserProcess assembly was not found: $(_CefGlueBrowserProcessAssembly)" />
    </Target>

    <Target Name="CreateCefGlueBrowserProcessAppHost" DependsOnTargets="PrepareCefGlueBrowserProcessAppHost" Inputs="$(_CefGlueBrowserProcessAssembly);$(AppHostSourcePath);$(MSBuildAllProjects)" Outputs="$(_CefGlueBrowserProcessAppHost)" Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(IsTestProject)' == 'true') and '$(DesignTimeBuild)' != 'true'">
        <MakeDir Directories="$(_CefGlueBrowserProcessIntermediateDirectory)staging" />
        <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)" AppHostDestinationPath="$(_CefGlueBrowserProcessStagingAppHost)" AppBinaryName="Xilium.CefGlue.BrowserProcess.dll" IntermediateAssembly="$(_CefGlueBrowserProcessAssembly)" WindowsGraphicalUserInterface="$(_CefGlueBrowserProcessWindowsGui)" EnableMacOSCodeSign="$(_CefGlueBrowserProcessMacOSCodeSign)" Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
        <PatchPeStackReserve Condition="$(CefGlueTargetRuntimeIdentifier.StartsWith('win-'))" FilePath="$(_CefGlueBrowserProcessStagingAppHost)" StackReserveBytes="8388608" />
        <Move SourceFiles="$(_CefGlueBrowserProcessStagingAppHost)" DestinationFiles="$(_CefGlueBrowserProcessAppHost)" />
    </Target>
</Project>
