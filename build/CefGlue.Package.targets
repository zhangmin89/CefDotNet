<Project>
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectBrowserProcessesForPackage</TargetsForTfmSpecificContentInPackage>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <!-- 把 CefGlue.Common 的两个 buildTransitive 文件装进 nupkg -->
    <ItemGroup>
        <None Include="$(MSBuildProjectDirectory)\buildTransitive\CefGlue.Common.props" Pack="true" PackagePath="buildTransitive/CefGlue.Common.props" />
        <None Include="$(MSBuildProjectDirectory)\buildTransitive\CefGlue.Common.targets" Pack="true" PackagePath="buildTransitive/CefGlue.Common.targets" />
    </ItemGroup>

    <!-- 原本就有的 ProjectReference 打包逻辑 -->
    <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
        </ItemGroup>
    </Target>

    <Target Name="CollectBrowserProcessesForPackage" DependsOnTargets="ResolveCefGlueBrowserProcessProjectAssets">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(CefGlueBrowserProcessAssetsPath)*.dll;$(CefGlueBrowserProcessAssetsPath)*.pdb;$(CefGlueBrowserProcessAssetsPath)*.deps.json;$(CefGlueBrowserProcessAssetsPath)*.runtimeconfig.json">
                <PackagePath>tools/browser-process/%(FileName)%(Extension)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

</Project>
